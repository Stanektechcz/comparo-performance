# Staging template (A-39, docs/operations/staging.md). Copy to the server's
# shared .env, fill every empty value from the secret store, never commit it.
# Staging is production-like: Meilisearch required, Horizon supervisors, the
# production password policy, APP_DEBUG off. Unlike production it may carry the
# labelled prototype demo dataset (COMPARO_DEMO_ACCOUNTS=true) and stays
# resettable (migrate:fresh is allowed).

APP_NAME="Comparo Performance (staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Structured logs to stderr (collected by the process manager / journald).
LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=comparo_staging
DB_USERNAME=comparo_staging
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Redis + Horizon (config/horizon.php "staging" supervisors).
QUEUE_CONNECTION=redis
QUEUE_LONG_CONNECTION=redis-long
QUEUE_LONG_RETRY_AFTER=960
CACHE_STORE=redis
CACHE_PREFIX=comparo_staging_cache_
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_PREFIX=comparo_staging_
HORIZON_PATH=staff/horizon

# Behind a reverse proxy / load balancer: its address(es), comma-separated.
TRUSTED_PROXIES=

SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
SCOUT_PREFIX=staging_
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

INERTIA_SSR_ENABLED=true

# Mail: an SMTP relay; staging should use a catch-all/sandbox inbox.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@staging.example.com"
MAIL_FROM_NAME="${APP_NAME}"

PASSKEYS_USER_HANDLE_SECRET=

COMPARO_DEFAULT_MARKET=DE
COMPARO_LAUNCH_MARKETS=DE,AT
# Labelled prototype demo data + demo personas (never in production).
# Leave the password empty to get a random one printed once by the seeder.
COMPARO_DEMO_ACCOUNTS=true
COMPARO_DEMO_PASSWORD=

# Feature flags — set every flag explicitly on staging.
FEATURE_MERCHANT_FEEDS=true
FEATURE_FEED_URL_FETCH=true
FEATURE_MATCHING_AUTO_PUBLISH=true
FEATURE_REVIEWS_SUBMISSION=false
FEATURE_MERCHANT_REVIEWS=false
FEATURE_BILLING_LIVE_INVOICING=false
FEATURE_BILLING_STRIPE=false
FEATURE_AFFILIATE_NETWORK_API=false
FEATURE_DELIVERY_PROMISE=false
FEATURE_DELIVERY_PROMISE_48H=false
FEATURE_BUYER_SUBSCRIPTIONS=false
FEATURE_XP_REDEMPTION=false
FEATURE_MERCHANT_COMMISSION_DISPLAY=false
FEATURE_SELF_SERVE_AD_BOOKING=false
FEATURE_DEVELOPERS_GATE_EXEMPT=false
FEATURE_VERIFICATION_FORWARDED_EMAIL=false
FEATURE_LIVE_ROOMS=false

VITE_APP_NAME="${APP_NAME}"
