APP_NAME="Comparo Performance"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# UI language (i18n). Deliberately independent of market, currency and
# compliance jurisdiction — see docs/adr/0008-market-locale-currency.md.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Use "json" in production for structured logs (see config/logging.php).
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# Production and CI target: PostgreSQL 16+.
# Local fallback without Docker/PostgreSQL: DB_CONNECTION=sqlite
# (database/database.sqlite). Migrations are written to run on both.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=comparo
DB_USERNAME=comparo
DB_PASSWORD=comparo

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Queues / cache — production: redis + Horizon.
# Local fallback without Redis: QUEUE_CONNECTION=database, CACHE_STORE=database
# ---------------------------------------------------------------------------
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=comparo_cache_

# Long-running feed/matching/pricing jobs (queues: feed-import, matching, pricing;
# timeouts up to 900s). retry_after must stay above the longest job timeout.
QUEUE_LONG_CONNECTION=redis-long
QUEUE_LONG_RETRY_AFTER=960

MEMCACHED_HOST=127.0.0.1

# predis is a pure-PHP client and needs no PHP extension; switch to phpredis
# in production when the extension is installed.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

HORIZON_PATH=staff/horizon

# ---------------------------------------------------------------------------
# Search — production: meilisearch. Local fallback: database.
# ---------------------------------------------------------------------------
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=masterKey-change-me

# ---------------------------------------------------------------------------
# Mail — local: Mailpit (SMTP 1025, UI 8025). Production: postmark or mailgun.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@comparo.example"
MAIL_FROM_NAME="${APP_NAME}"
POSTMARK_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_SECRET=

# ---------------------------------------------------------------------------
# Object storage — local: MinIO (S3 compatible). Receipts use the private
# bucket and are only ever served through signed temporary URLs.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=comparo
AWS_SECRET_ACCESS_KEY=comparo-secret
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=comparo-private
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ---------------------------------------------------------------------------
# Comparo
# ---------------------------------------------------------------------------
# Default market for anonymous visitors (ISO 3166-1 alpha-2).
COMPARO_DEFAULT_MARKET=DE
# Demo personas (shopper / merchant / staff) are only ever seeded when true
# and never in production. Leave the password empty to get a random one
# printed by the seeder.
COMPARO_DEMO_ACCOUNTS=true
COMPARO_DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# ADR-0018 business-decision config (config/comparo.php). Most decided values
# are fixed (methodology, legal or DPO-owned) and are not env-overridable;
# these are the ones an operator legitimately tunes.
# ---------------------------------------------------------------------------
# D-01: comma-separated ISO 3166-1 alpha-2 codes a production market seeder
# may activate. Does not affect the demo importer (all 27 markets stay active).
COMPARO_LAUNCH_MARKETS=DE,AT
# D-06: age (days) of the last known FX rate before a display warning.
COMPARO_FX_STALE_WARNING_DAYS=4
# D-08: internal moderation SLA is published only after 4 weeks at >= 90%.
COMPARO_MODERATION_PUBLISH_SLA=false
# D-23: fraud-hash salt rotation cadence, in days.
COMPARO_FRAUD_SALT_ROTATION_DAYS=30
# D-17: affiliate disclosure interstitial auto-continue delay, in seconds.
COMPARO_AFFILIATE_INTERSTITIAL_SECONDS=3
# D-20: share of each visibility surface withheld from sale (0-1).
COMPARO_VISIBILITY_HOLDBACK_RATIO=0.2
# D-15: hours a shopper-reported delivery/return event stays provisional.
COMPARO_ORDERS_PROVISIONAL_HOURS=48

# ---------------------------------------------------------------------------
# Feature flags (config/features.php; App\Domain\Platform\Features\FeatureFlags)
# ---------------------------------------------------------------------------
FEATURE_MERCHANT_FEEDS=true
FEATURE_FEED_URL_FETCH=true
FEATURE_MATCHING_AUTO_PUBLISH=true

# ADR-0018 business-decision flags — all default off. Each needs a human
# sign-off or contract before it may ever be enabled (docs/adr/0018-business-decisions-baseline.md).
FEATURE_BILLING_LIVE_INVOICING=false
FEATURE_BILLING_STRIPE=false
FEATURE_AFFILIATE_NETWORK_API=false
FEATURE_DELIVERY_PROMISE=false
FEATURE_DELIVERY_PROMISE_48H=false
FEATURE_BUYER_SUBSCRIPTIONS=false
FEATURE_XP_REDEMPTION=false
FEATURE_MERCHANT_COMMISSION_DISPLAY=false
FEATURE_SELF_SERVE_AD_BOOKING=false
FEATURE_DEVELOPERS_GATE_EXEMPT=false
FEATURE_VERIFICATION_FORWARDED_EMAIL=false
FEATURE_LIVE_ROOMS=false

# A-36: on only in local/testing/demo by default (see config/features.php);
# set explicitly to override that env-aware default.
FEATURE_REVIEWS_SUBMISSION=true
FEATURE_MERCHANT_REVIEWS=true

VITE_APP_NAME="${APP_NAME}"
